# Copy to backend/.env and fill in real values. .env is gitignored -- never commit real secrets.

# -- LLM (shared across schema discovery, dashboard, chat) --
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -- Phase 6: Postgres --
# Local dev (docker-compose): postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow
# Prod: your Neon/Supabase connection string
DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow

# -- Phase 6: JWT auth --
# Required -- the app refuses to start without it (see main.py). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# -- Phase 6: object storage (MinIO locally via docker-compose, S3 in prod) --
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=insightflow-datasets
AWS_ACCESS_KEY_ID=insightflow
AWS_SECRET_ACCESS_KEY=insightflow123
AWS_REGION=us-east-1

# -- Phase 6: production hardening --
# Comma-separated browser origins allowed to call this API cross-origin. Empty = deny all
# (correct until a frontend exists -- Phase 8). Example once one does:
#   CORS_ALLOWED_ORIGINS=https://app.insightflow.example.com
CORS_ALLOWED_ORIGINS=
# In-memory, per-process stopgap limit on /auth/login and /auth/register (see
# auth/rate_limit.py) -- not distributed, resets on restart; Phase 7 replaces this with a real
# Redis-backed limiter covering more than just auth.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
