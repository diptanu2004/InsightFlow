# Copy to backend/.env and fill in real values. .env is gitignored -- never commit real secrets.

# -- LLM (shared across schema discovery, dashboard, chat) --
GROQ_API_KEY=
# llama-3.3-70b-versatile (the original default) was deprecated by Groq -- 404 model_not_found.
# openai/gpt-oss-120b is what poc4_nl_chatbot's own .env uses and CLAUDE.md's POC4 M4 evaluation
# verified working.
GROQ_MODEL=openai/gpt-oss-120b

# -- Phase 6: Postgres --
# Local dev (docker-compose): postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow
# Prod: your Neon/Supabase connection string
DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow

# Optional. The test suite runs against separate Postgres and Redis databases so it never touches
# dev state (see the root conftest.py for why both are needed). Defaults: DATABASE_URL's database
# name with `_test` appended (created automatically), and Redis logical db 15. Only set these to
# point tests somewhere else entirely -- pointing either back at dev is refused at startup.
# TEST_DATABASE_URL=postgresql+psycopg://insightflow:insightflow@localhost:5432/insightflow_test
# TEST_REDIS_URL=redis://localhost:6379/15

# -- Phase 6: JWT auth --
# Required -- the app refuses to start without it (see main.py). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# -- Phase 6: object storage (MinIO locally via docker-compose, S3 in prod) --
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=insightflow-datasets
AWS_ACCESS_KEY_ID=insightflow
AWS_SECRET_ACCESS_KEY=insightflow123
AWS_REGION=us-east-1

# -- Phase 6: production hardening --
# Comma-separated browser origins allowed to call this API cross-origin. Empty = deny all
# (correct until a frontend exists -- Phase 8). Example once one does:
#   CORS_ALLOWED_ORIGINS=https://app.insightflow.example.com
CORS_ALLOWED_ORIGINS=
# Redis-backed, distributed rate limit on /auth/login and /auth/register (see auth/rate_limit.py).
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# -- Phase 7: Redis --
# Local dev (docker-compose): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# Distributed rate limit on schema/discover, dashboard/generate, chat/ask -- keyed per-project
# (LLM spend is a tenant budget concern, not a per-client one).
LLM_RATE_LIMIT_MAX_REQUESTS=30
LLM_RATE_LIMIT_WINDOW_SECONDS=60
# Result cache TTL for analytics/query, dashboard/generate, chat/ask (see cache.py) -- memory
# hygiene only, not correctness: a dataset's rows never change without a new Dataset row.
RESULT_CACHE_TTL_SECONDS=86400
# Async schema-discovery job queue (see jobs.py/worker.py). Requires a worker process running
# (`docker compose up -d worker`, or `python -m insightflow_backend.worker` directly).
RQ_QUEUE_NAME=insightflow-discovery
DISCOVERY_JOB_TIMEOUT_SECONDS=600
